  "cues": [
    {
      "id": "L01",
      "start": 0.7,
      "end": 1.472,
      "text": "Meet Sam."
    },
    {
      "id": "L02",
      "start": 1.822,
      "end": 3.74,
      "text": "Sam found forty acres she might buy."
    },
    {
      "id": "L03",
      "start": 4.94,
      "end": 9.1,
      "text": "No survey. No soil report. Just an address and an asking price."
    },
    {
      "id": "L04",
      "start": 9.45,
      "end": 13.418,
      "text": "Before she makes an offer, she needs one number: what the site work will cost."
    },
    {
      "id": "L05",
      "start": 14.718,
      "end": 17.701,
      "text": "Marine clay. Shallow rock. A high water table."
    },
    {
      "id": "L06",
      "start": 18.101,
      "end": 23.047,
      "text": "Guess high, she loses the deal. Guess low, and a quarter million walks out of the pro forma."
    },
    {
      "id": "L07",
      "start": 24.847,
      "end": 26.361,
      "text": "That's why we built DirtBid."
    },
    {
      "id": "L08",
      "start": 28.161,
      "end": 29.222,
      "text": "Type in the address."
    },
    {
      "id": "L09",
      "start": 29.572,
      "end": 39.384,
      "text": "DirtBid pulls the official U S D A soil survey and local cost data, then prices the site work line by line. On the safe side, so your offer is too."
    },
    {
      "id": "L10",
      "start": 39.634,
      "end": 42.338,
      "text": "Three weeks of due diligence, in under thirty minutes."
    },
    {
      "id": "L11",
      "start": 43.388,
      "end": 50.833,
      "text": "Then it hands you a vetted team for every step: survey, civil, geo-tech, title, financing, and the crew that moves the dirt."
    },
    {
      "id": "L12",
      "start": 52.133,
      "end": 55.354,
      "text": "Screen your first parcel free, at dirt bid A I dot com."
    },
    {
      "id": "L13",
      "start": 55.754,
      "end": 59.09,
      "text": "No credit card. Just the number, before you make the offer."
    }
  ]
