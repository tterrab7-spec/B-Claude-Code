# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgres://postgres@127.0.0.1:5432/dirtbid
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:5432/dirtbid_test   # used when NODE_ENV=test
WEB_URL=http://localhost:5173        # CORS origin + base for magic links / report links
JWT_SECRET=change-me-to-a-long-random-string
RATE_LIMIT_MAX=300                   # global requests per minute per IP (public routes have tighter limits)

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_DRIVER=console                 # console | resend | ses
EMAIL_FROM="DirtBid Build <no-reply@dirtbid.example>"
RESEND_API_KEY=                      # when EMAIL_DRIVER=resend
AWS_REGION=us-east-1                 # when EMAIL_DRIVER=ses or S3_BUCKET is set (requires @aws-sdk/client-sesv2)

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                   # leave empty to run without Stripe (dev mark-paid endpoint is available outside production)
STRIPE_WEBHOOK_SECRET=               # from `stripe listen` or the dashboard webhook endpoint

# ── Automations (n8n) ─────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=                     # e.g. https://n8n.yourdomain.com/webhook/dirtbid-events ; empty disables delivery (events still stored)
WEBHOOK_SECRET=change-me             # HMAC-SHA256 key for the X-DirtBid-Signature header

# ── Assistant ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                   # empty = deterministic rules mode
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Documents ─────────────────────────────────────────────────────────────────
S3_BUCKET=                           # empty = local disk uploads (requires @aws-sdk/client-s3 + @aws-sdk/s3-request-presigner when set)
LOCAL_UPLOAD_DIR=./uploads

# ── Parcel data (address-first feasibility) ───────────────────────────────────
# POST /v1/parcels/resolve and /v1/feasibility/from-address call public services (Census geocoder,
# VGIN parcels, FEMA NFHL, FWS NWI, USGS 3DEP, USDA SSURGO). No keys needed for those.
REGRID_API_KEY=                      # optional; enables nationwide zoning lookup via Regrid when no locality layer is configured
PARCEL_TIMEOUT_MS=12000              # per upstream request
PARCEL_CACHE_TTL_HOURS=24            # parcel_lookups rows younger than this are served without re-querying
