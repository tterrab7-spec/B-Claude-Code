# --- Server ---
PORT=3000
NODE_ENV=production
PUBLIC_URL=https://app.parcelyst.com
DB_PATH=./data/parcelyst.db
ADMIN_EMAILS=you@example.com
SEED_DEMO=true            # load the synthetic demo dataset on first boot

# --- Billing (Stripe) ---
# Leave STRIPE_SECRET_KEY empty and set BILLING_MODE=dev to test purchases locally without charging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=7
STRIPE_PRICE_INVESTOR_MONTHLY=
STRIPE_PRICE_INVESTOR_ANNUAL=
STRIPE_PRICE_AGENT_MONTHLY=
STRIPE_PRICE_AGENT_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_REPORT1=
STRIPE_PRICE_REPORT5=
STRIPE_PRICE_REPORT15=
STRIPE_PRICE_MARKET=
# BILLING_MODE=dev

# --- Data providers (each optional; turns on when set) ---
RENTCAST_API_KEY=        # property records, owner, tax, value + rent AVMs, sale listings
ATTOM_API_KEY=           # expanded profiles, absentee status, distress (higher tier)
REGRID_TOKEN=            # parcels, acreage, zoning, land use (land + commercial)
FRED_API_KEY=            # free: Freddie Mac PMMS, Treasury yields

# --- Tax referral partner shown in the report's tax section ---
TAX_PARTNER_NAME=Sterling Tax Management
TAX_PARTNER_URL=
